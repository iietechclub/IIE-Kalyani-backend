{
  "kind": "collectionType",
  "collectionName": "gallery_items",
  "info": {
    "singularName": "gallery-item",
    "pluralName": "gallery-items",
    "displayName": "GalleryItem"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 150,
      "required": true
    },
    "tag": {
      "type": "string",
      "minLength": 2,
      "maxLength": 30,
      "required": true
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "default": "Image",
      "enum": [
        "Image",
        "Video"
      ]
    },
    "image": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "Image"
          ]
        }
      },
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "videoPreview": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "Video"
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "youtubeUrl": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "Video"
          ]
        }
      },
      "minLength": 5,
      "required": false
    }
  }
}
