{
  "kind": "collectionType",
  "collectionName": "activities",
  "info": {
    "singularName": "activity",
    "pluralName": "activities",
    "displayName": "Activity"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "description": {
      "type": "text",
      "minLength": 5,
      "maxLength": 400,
      "required": true
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::icon-picker.icon"
    },
    "timing": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "required": true
    }
  }
}
