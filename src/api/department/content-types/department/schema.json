{
  "kind": "collectionType",
  "collectionName": "departments",
  "info": {
    "singularName": "department",
    "pluralName": "departments",
    "displayName": "Department"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "required": true
    },
    "short_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "tagline": {
      "type": "text",
      "minLength": 5,
      "maxLength": 400,
      "required": true
    },
    "previewImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "bannerImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::icon-picker.icon",
      "required": false
    },
    "hod": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::facility.facility"
    },
    "hod_message": {
      "type": "text",
      "minLength": 5,
      "required": true
    },
    "oneline_vision": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "required": true
    },
    "oneline_mission": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "required": true
    },
    "oneline_labs": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "required": true
    },
    "about": {
      "type": "blocks",
      "required": true
    },
    "about_image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "vision": {
      "type": "blocks",
      "required": true
    },
    "mission": {
      "type": "blocks",
      "required": true
    },
    "labs": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::gallery-item.gallery-item"
    }
  }
}
