{
  "kind": "collectionType",
  "collectionName": "success_stories",
  "info": {
    "singularName": "success-story",
    "pluralName": "success-stories",
    "displayName": "SuccessStory"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "required": true
    },
    "department": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::department.department"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "youtube_url": {
      "type": "string",
      "minLength": 5,
      "required": true
    },
    "passout_year": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4,
      "required": true,
      "regex": "^[1-9]{1}[0-9]{3}$"
    },
    "employer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200,
      "required": true
    },
    "salary": {
      "type": "string",
      "minLength": 4,
      "maxLength": 8,
      "required": true
    },
    "description": {
      "type": "text",
      "minLength": 5,
      "maxLength": 400,
      "required": true
    }
  }
}
