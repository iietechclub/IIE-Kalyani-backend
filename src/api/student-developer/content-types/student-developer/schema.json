{
  "kind": "collectionType",
  "collectionName": "student_developers",
  "info": {
    "singularName": "student-developer",
    "pluralName": "student-developers",
    "displayName": "StudentDeveloper"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "default": "Student",
      "enum": [
        "Student",
        "Other"
      ]
    },
    "contribution": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "required": true
    },
    "department": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::department.department",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "Student"
          ]
        }
      }
    },
    "batch": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "Student"
          ]
        }
      },
      "minLength": 4,
      "maxLength": 40,
      "required": false
    },
    "otherFrom": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "Other"
          ]
        }
      },
      "minLength": 1,
      "maxLength": 100,
      "required": false
    },
    "github": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "required": true
    },
    "linkedin": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "required": true
    }
  }
}
