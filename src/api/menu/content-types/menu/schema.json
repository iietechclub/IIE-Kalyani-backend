{
  "kind": "collectionType",
  "collectionName": "menus",
  "info": {
    "singularName": "menu",
    "pluralName": "menus",
    "displayName": "Menu"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 50,
      "required": true,
      "unique": false
    },
    "contains": {
      "type": "enumeration",
      "required": true,
      "default": "SubMenus",
      "enum": [
        "Link",
        "MenuItems",
        "SubMenus"
      ]
    },
    "url": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "Link"
          ]
        }
      }
    },
    "menuItems": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "contains"
            },
            "MenuItems"
          ]
        }
      },
      "component": "navigation.menu-item",
      "repeatable": true
    },
    "submenus": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "contains"
            },
            "SubMenus"
          ]
        }
      },
      "component": "navigation.submenu",
      "repeatable": true
    }
  }
}
