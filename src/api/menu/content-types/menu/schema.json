{
  "kind": "collectionType",
  "collectionName": "menus",
  "info": {
    "singularName": "menu",
    "pluralName": "menus",
    "displayName": "Menu"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 50,
      "required": true,
      "unique": false
    },
    "contains": {
      "type": "enumeration",
      "required": true,
      "default": "SubMenus",
      "enum": [
        "Link",
        "MenuItems",
        "SubMenus"
      ]
    },
    "link": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "contains"
            },
            "Link"
          ]
        }
      },
      "component": "ui.link-button",
      "repeatable": false
    },
    "menuItems": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "contains"
            },
            "MenuItems"
          ]
        }
      },
      "component": "navigation.menu-item",
      "repeatable": true
    },
    "submenus": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "contains"
            },
            "SubMenus"
          ]
        }
      },
      "component": "navigation.submenu",
      "repeatable": true
    },
    "image": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "contains"
            },
            "SubMenus"
          ]
        }
      },
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "image_title": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "contains"
            },
            "SubMenus"
          ]
        }
      },
      "minLength": 3,
      "maxLength": 160,
      "required": false
    },
    "image_subtitle": {
      "type": "text",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "contains"
            },
            "SubMenus"
          ]
        }
      },
      "minLength": 5,
      "maxLength": 200,
      "required": false
    }
  }
}
