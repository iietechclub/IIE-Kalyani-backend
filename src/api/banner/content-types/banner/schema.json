{
  "kind": "collectionType",
  "collectionName": "banners",
  "info": {
    "singularName": "banner",
    "pluralName": "banners",
    "displayName": "Banner"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "required": true
    },
    "tag": {
      "type": "string",
      "minLength": 2,
      "maxLength": 30,
      "required": true
    },
    "subtitle": {
      "type": "text",
      "minLength": 5,
      "required": true
    },
    "ctaButtons": {
      "type": "component",
      "component": "ui.cta-button",
      "repeatable": true,
      "min": 1,
      "max": 3
    }
  }
}
