{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "logoTitle": {
      "type": "string",
      "maxLength": 50,
      "required": true
    },
    "logoSubtitle": {
      "type": "string",
      "maxLength": 60,
      "required": true
    },
    "logoImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "contactNo": {
      "type": "string",
      "required": true
    },
    "contactEmail": {
      "type": "email",
      "required": true
    },
    "locationTitle": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100,
      "required": true
    },
    "topLinks": {
      "type": "component",
      "component": "navigation.menu-item",
      "repeatable": true,
      "required": true,
      "min": 1
    },
    "menus": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::menu.menu"
    },
    "socialLinks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::social-link.social-link"
    },
    "footerDescription": {
      "type": "text",
      "minLength": 5,
      "required": true
    },
    "footerColumns": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::footer-column.footer-column"
    }
  }
}
